{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "command-raw",
    "source": "pokeget gengar --hide-name"

  },

  "display": {
    "separator": " : "
  },

  "modules": [ 
    {
      "type": "custom",
      "format": "\u001b[1;35m               specs",
      "keyColor": "magenta"
    },

    {
      "type": "custom",
      "format": "┌───────────────────────────────────────┐"
    },

    {
      "type": "os",
      "key": " OS",
      "format": "Mint",
      "keyColor": "magenta"
    },

    {
      "type": "kernel",
      "key": " Kernel",
      "keyColor": "magenta"
    },

    {
      "type": "custom",
      "key": " Terminal",
      "format" : "kitty",
      "keyColor": "magenta"
    },

    {
      "type": "wm",
      "key": " WM",
      "keyColor": "magenta"
    },

    {
      "type": "custom",
      "format": "└───────────────────────────────────────┘"
    },

    "break",

    {
      "type": "title",
      "format": "\u001b[1;35m          xavier @ laptopx",
      "keyColor": "magenta"
    },

    {
      "type": "custom",
      "format": "┌───────────────────────────────────────┐"
    },

    {
      "type": "custom",
      "key": " CPU",
      "format": "Intel i7 @ 3.90 GHz",
      "keyColor": "magenta"
    },

    {
      "type": "gpu",
      "key": " GPU",
      "format": "Intel G7 @ 1.10 GHz",
      "keyColor": "magenta"
    },

    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "magenta"
    },

    {
      "type": "uptime",
      "key": " Uptime",
      "keyColor": "magenta"
    },

    {
      "type": "custom",
      "format": "└───────────────────────────────────────┘"
    },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "square"
    },

    "break"
  ]
}
